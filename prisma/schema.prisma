generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?   // Hashed password
  image         String?
  role          Role      @default(USER)
  clients       Client[]
  orders        Order[]
  tasks         Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String?         @unique
  phone          String?
  address        String?
  notes          String?         @db.Text
  measurements   Json?           // Flexible JSON for measurement sets
  portalPassword String?         // Hashed password for client portal access
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  orders         Order[]
  communications Communication[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  status          OrderStatus     @default(DRAFT)
  priority        Priority        @default(MEDIUM)
  totalAmount     Float?          // Final total
  depositPaid     Float?          // Deposit amount
  depositDate     DateTime?
  balanceDue      Float?          // Calculated
  dueDate         DateTime?
  notes           String?         @db.Text
  garments        Garment[]
  tasks           Task[]
  communications  Communication[]
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Garment {
  id              String      @id @default(cuid())
  name            String      // e.g., "Wedding Dress", "Blazer"
  description     String?
  designFiles     String[]    // URLs to sketches/photos
  fabricType      String?
  color           String?
  pattern         String?     // Pattern file URL
  measurements    Json?       // Custom measurements for this garment
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  tasks           Task[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Task {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus  @default(TODO)
  priority        Priority    @default(MEDIUM)
  assignedTo      String?     // User ID
  assignedUser    User?       @relation(fields: [assignedTo], references: [id])
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  garmentId       String?
  garment         Garment?    @relation(fields: [garmentId], references: [id])
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  timeSpent       Float?      // Hours tracked
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Communication {
  id              String      @id @default(cuid())
  type            CommType    @default(EMAIL)
  direction       CommDirection @default(INBOUND)
  subject         String?
  content         String      @db.Text
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  orderId         String?
  order           Order?      @relation(fields: [orderId], references: [id])
  attachments     String[]
  externalId      String?     // For email/message IDs
  createdAt       DateTime    @default(now())
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DESIGN_PHASE
  FABRIC_SOURCING
  CUTTING
  SEWING
  FITTING
  QUALITY_CHECK
  COMPLETED
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum CommType {
  EMAIL
  WHATSAPP
  SMS
  PHONE
  NOTE
  MEETING
}

enum CommDirection {
  INBOUND
  OUTBOUND
}
